# MediaCat control panel as a user service. Install (from the mediacat/ folder):
#   mkdir -p ~/.config/systemd/user
#   sed "s#@CHECKOUT@#$PWD#" tools/ctl_portal/mediacat-ctl-web.service.in > ~/.config/systemd/user/mediacat-ctl-web.service
#   systemctl --user daemon-reload && systemctl --user enable --now mediacat-ctl-web
[Unit]
Description=MediaCat control panel (mediacat-ctl.sh web front-end) on 127.0.0.1:8810
After=docker.service

[Service]
WorkingDirectory=@CHECKOUT@
ExecStart=@CHECKOUT@/.venv/bin/python -m tools.ctl_portal --host 127.0.0.1
Restart=on-failure
RestartSec=5
# Keep the docs server (started by actions 1, 3 and 38) alive across panel restarts
KillMode=process

[Install]
WantedBy=default.target
