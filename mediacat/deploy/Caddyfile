# Caddyfile — MediaCat reverse proxy.
#
# In dev  (PUBLIC_SCHEME=http): plain HTTP, no cert management.
# In prod (PUBLIC_SCHEME=https): automatic ACME TLS via Let's Encrypt.
#
# Environment variables are substituted by Caddy at startup.

{
	# Global options
	admin off                        # disable the admin API in production
	log {
		output stdout
		format json
	}

	# Local CA (used for *.localhost): long-lived intermediate so the leaf
	# certificates below can outlast a sleeping PC / stopped WSL.
	pki {
		ca local {
			intermediate_lifetime 90d
		}
	}
}

# Locally-trusted certificates for the .localhost sites.  Caddy's default
# 12-hour certificates expire while the PC sleeps, and on wake-up the browser
# sees an expired one ("not secure") until Caddy's next check renews it.
# 30 days, renewed after ~20.  Remove the imports for a public domain, where
# Caddy obtains certificates from Let's Encrypt instead.
(local_tls) {
	tls {
		issuer internal {
			lifetime 30d
		}
	}
}

{$PUBLIC_SCHEME:-https}://{$PUBLIC_HOSTNAME:-mediacat.localhost} {
	import local_tls

	# ----- Security headers -----
	header {
		Strict-Transport-Security  "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options     "nosniff"
		X-Frame-Options            "DENY"
		Referrer-Policy            "strict-origin-when-cross-origin"
		Permissions-Policy         "camera=(), microphone=(), geolocation=()"
		# CSP is set by the app itself (per-response), so we don't override here.
		-Server
		-X-Powered-By
	}

	# ----- Rate limiting (global) -----
	# Caddy rate-limit module (caddy-docker images often include it).
	# If not available, comment this block; the app has its own rate limiter.
	# rate_limit {remote.host} 60r/m

	# ----- Reverse proxy to the app container -----
	reverse_proxy app:8000 {
		# Propagate real client IP
		header_up X-Real-IP        {remote_host}
		header_up X-Forwarded-For  {remote_host}
		header_up X-Request-ID     {http.request.uuid}

		# Health check on the upstream
		health_uri  /healthz
		health_interval 15s
		health_timeout  5s
		health_status  200

		# Buffer limits
		flush_interval -1
	}

	# ----- Logs -----
	log {
		output stdout
		format json
	}
}

# MinIO console — separate subdomain, optional.
{$PUBLIC_SCHEME:-https}://minio.{$PUBLIC_HOSTNAME:-mediacat.localhost} {
	import local_tls

	reverse_proxy minio:9001
}

# Docs server — MkDocs live preview (active when docs server is running via mediacat-ctl.sh).
{$PUBLIC_SCHEME:-https}://docs.{$PUBLIC_HOSTNAME:-mediacat.localhost} {
	import local_tls

	reverse_proxy http://host.docker.internal:8800
	log {
		output stdout
		format json
	}
}

# Open WebUI — browser chat UI for Ollama (only active when ollama profile is up).
{$PUBLIC_SCHEME:-https}://ollama.{$PUBLIC_HOSTNAME:-mediacat.localhost} {
	import local_tls

	reverse_proxy open-webui:8080 {
		health_uri  /health
		health_interval 30s
		health_timeout  10s
		health_status  200
	}
	log {
		output stdout
		format json
	}
}
